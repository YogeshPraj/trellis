<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.1.0</Version>
    <Authors>Yogesh Prajapati</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YogeshPraj/trellis</RepositoryUrl>
    <PackageProjectUrl>https://github.com/YogeshPraj/trellis</PackageProjectUrl>
    <PackageTags>ai;agents;llm;langgraph;graph;orchestration</PackageTags>
  </PropertyGroup>
</Project>
