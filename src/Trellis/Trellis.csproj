<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Typed AI agents for .NET on Microsoft.Extensions.AI — strongly-typed structured outputs, tools as plain C# methods with [Tool] source generation, dependency-injected agents, and graph workflow integration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trellis.Graph\Trellis.Graph.csproj" />
    <ProjectReference Include="..\Trellis.Tools.Generator\Trellis.Tools.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the [Tool] source generator inside this package. -->
  <ItemGroup>
    <None Include="..\Trellis.Tools.Generator\bin\$(Configuration)\netstandard2.0\Trellis.Tools.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
