<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Azure Cosmos DB provider for Trellis shared state: durable cross-instance storage for conversations, router health, and archives, with ETag-based compare-and-swap.</Description>
    <PackageTags>ai;agents;llm;azure;cosmosdb;trellis</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <!-- The Cosmos SDK serializes with Newtonsoft by default and requires this explicitly. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trellis.State\Trellis.State.csproj" />
  </ItemGroup>

</Project>
